# ---------- Firebase web app (Project settings → General → Your apps) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin for the Elysia API ----------
# FIREBASE_PROJECT_ID alone (or NEXT_PUBLIC_FIREBASE_PROJECT_ID) lets the API verify sign-ins.
# Firestore and user administration also need a service account:
# Either the whole service-account JSON (raw or base64) ...
FIREBASE_SERVICE_ACCOUNT=
# ... or the three fields:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated emails that become admins when they register
ADMIN_EMAILS=

NEXT_PUBLIC_SITE_URL=https://techzup.space

# ---------- Local development only ----------
# Sign in with any email without Firebase (ignored in production)
# AUTH_DEV_MODE=1
# NEXT_PUBLIC_AUTH_DEV_MODE=1
